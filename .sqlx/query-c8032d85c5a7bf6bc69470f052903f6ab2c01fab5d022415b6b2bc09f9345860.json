  "query": "\n        SELECT p.farmer_id, f.email AS farmer_email\n        FROM stock s\n        JOIN products p ON p.id = s.product_id\n        JOIN farmers  f ON f.id = p.farmer_id\n        WHERE s.id = $1\n        ",
