  "db_name": "PostgreSQL",
  "query": "\n        UPDATE orders o\n        SET order_status = $1::order_status,\n            updated_at   = now()\n        FROM stock s\n        JOIN products p ON p.id = s.product_id\n        WHERE o.stock_id  = s.id\n          AND p.farmer_id = $2\n          AND o.id        = $3\n        ",
