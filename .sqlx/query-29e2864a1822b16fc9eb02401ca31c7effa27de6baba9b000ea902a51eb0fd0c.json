  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            o.id,\n            o.order_key,\n            o.order_status::text   AS \"order_status!: String\",\n            o.payment_status::text AS \"payment_status!: String\",\n            o.guest_email,\n            o.guest_phone,\n            o.delivery_address,\n            o.delivery_county,\n            o.delivery_postcode,\n            o.total_amount_gbp,\n            o.placed_at\n        FROM orders o\n        WHERE o.id = $1\n        ",
