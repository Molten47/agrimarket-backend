{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            id,\n            farmer_id,\n            order_id,\n            channel::text       AS \"channel!: String\",\n            recipient_email,\n            event_type,\n            payload,\n            is_sent,\n            sent_at,\n            created_at\n        FROM notifications\n        WHERE farmer_id  = $1\n          AND ($2::bool   IS NULL OR is_sent     = $2)\n          AND ($3::text   IS NULL OR event_type  = $3)\n        ORDER BY created_at DESC\n        LIMIT $4 OFFSET $5\n        ",
