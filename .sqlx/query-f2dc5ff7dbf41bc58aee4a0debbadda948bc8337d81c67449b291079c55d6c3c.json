  "query": "\n        UPDATE stock\n        SET\n            quantity_available  = $1,\n            low_stock_threshold = $2,\n            stock_status        = $3::stock_status,\n            updated_at          = now()\n        WHERE id = $4\n        RETURNING\n            id                  AS stock_id,\n            product_id,\n            quantity_available,\n            quantity_reserved,\n            low_stock_threshold,\n            stock_status::text  AS \"stock_status!: String\",\n            updated_at\n        ",
