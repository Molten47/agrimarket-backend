  "query": "\n        SELECT id, amount_gbp, category, description,\n               expense_date::text AS \"expense_date!: String\"\n        FROM expenses\n        WHERE farmer_id    = $1\n          AND expense_date BETWEEN $2 AND $3\n        ORDER BY expense_date DESC\n        ",
