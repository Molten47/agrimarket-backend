{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            oi.product_id,\n            p.name          AS product_name,\n            p.slug          AS product_slug,\n            oi.quantity,\n            oi.unit_price_gbp,\n            oi.subtotal_gbp\n        FROM order_items oi\n        JOIN products p ON p.id = oi.product_id\n        WHERE oi.order_id = $1\n        ",
