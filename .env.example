# ── AgriMarket Environment Variables ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker:
DATABASE_URL=postgresql://agrimarket:agrimarket_dev@localhost:5432/agrimarket
# Supabase (production):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

POSTGRES_PASSWORD=agrimarket_dev
DB_MAX_CONNS=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:agrimarket_dev@localhost:6379
REDIS_PASSWORD=agrimarket_dev

# ── Auth (RS256) ──────────────────────────────────────────────────────────────
# Generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   cat private.pem | base64 -w 0   → JWT_PRIVATE_KEY_B64
#   cat public.pem  | base64 -w 0   → JWT_PUBLIC_KEY_B64
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

ACCESS_TOKEN_TTL_SECS=900       # 15 minutes
REFRESH_TOKEN_TTL_SECS=604800   # 7 days

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_
EMAIL_FROM=AgriMarket <noreply@agrimarket.co.uk>

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
